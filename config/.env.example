# Copy to .env.local for local development. Never commit real values.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase — placeholders only
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Encryption key reference / managed secret integration
OAUTH_TOKEN_ENCRYPTION_KEY=

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Telegram control bot (new project bot; do not reuse old project by default)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Worker enrollment — use one-time, short-lived token from secure setup
WORKER_CONTROL_PLANE_URL=
WORKER_ENROLLMENT_TOKEN=

# Budget defaults are conservative examples; set explicit approved values
DEFAULT_DAILY_BUDGET_USD=0
DEFAULT_MONTHLY_BUDGET_USD=0
DEFAULT_PER_VIDEO_BUDGET_USD=0

# Safe mode
ENABLE_PUBLIC_PUBLISH=false
ENABLE_AUTOMATED_COMMENT_REPLIES=false
